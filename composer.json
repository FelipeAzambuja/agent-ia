{
    "name": "felipeazambuja/agente-ia",
    "description": "Agente de IA genérico em PHP: histórico por sessão, memória plugável, tools (function calling) e subagentes com handoff estruturado.",
    "type": "library",
    "license": "MIT",
    "keywords": ["ai", "agent", "llm", "openrouter", "function-calling", "subagentes", "orchestrator"],
    "require": {
        "php": "^8.2",
        "cheinisch/openrouter-php-client": "^0.3.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "AgenteIa\\": "src/"
        }
    },
    "autoload-dev": {
        "files": [
            "tests/Fakes.php"
        ],
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest"
    }
}
