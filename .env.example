# Integration tests against the real OpenRouter API (tests/OpenRouterTest.php).
# Copy to .env and fill in your key: cp .env.example .env
# Create a key at https://openrouter.ai/settings/keys

OPENROUTER_KEY=

# Main model: responses + tool calling (agent ->model).
# Defaults below are free models, so the tests cost nothing.
# Use any OpenRouter slug, e.g. openai/gpt-6-luna.
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free

# Light model: internal structured decisions (agent ->lightModel) —
# delegation status, topic selection, memory management. Needs
# structured-output support.
OPENROUTER_LIGHT_MODEL=inclusionai/ling-3.2-flash:free

# Real database for the RAG integration tests (DDEV MariaDB defaults).
RAG_DB_DSN=mysql:host=db;dbname=db;charset=utf8mb4
RAG_DB_USER=db
RAG_DB_PASSWORD=db

# Embedding model for the RAG integration tests (very cheap).
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
