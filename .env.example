# Integration tests against the real OpenRouter API (tests/OpenRouterTest.php).
# Copy to .env and fill in your key: cp .env.example .env
# Create a key at https://openrouter.ai/settings/keys

OPENROUTER_KEY=

# Real database for the RAG integration tests (DDEV MariaDB defaults).
RAG_DB_DSN=mysql:host=db;dbname=db;charset=utf8mb4
RAG_DB_USER=db
RAG_DB_PASSWORD=db

# Embedding model for the RAG integration tests (very cheap).
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
